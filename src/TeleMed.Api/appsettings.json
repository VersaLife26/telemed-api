  // Fixed windows per client IP (CF-Connecting-IP when ForwardedHeaders:TrustCloudflare), no queueing; excess requests get 429.
  // Sized for mobile carrier CGNAT, where many users share one address; the per-phone/email OTP cap (3 per hour) and the
  // 5-attempt OTP challenge limit are enforced separately in the domain and are not configurable.
  "RateLimiting": {
    // POST /auth/otp/send: bounds SMS/email cost from one address.
    "OtpSend": { "PermitLimit": 10, "Window": "00:10:00" },
    // POST /auth/otp/verify
    "OtpVerify": { "PermitLimit": 20, "Window": "00:10:00" },
    // POST /auth/register/email, /auth/login/email, /auth/google, /auth/password/reset: password guessing and account probing.
    "Login": { "PermitLimit": 20, "Window": "00:10:00" },
    // POST /doctor-applications
    "DoctorApply": { "PermitLimit": 5, "Window": "01:00:00" },
    // PUT /doctor-applications/{id}/documents/{type} and POST /vault/documents (up to 10 MB each).
    "DocumentUpload": { "PermitLimit": 30, "Window": "00:10:00" },
    // GET /doctor-applications/eligibility: stops enumerating SLMC numbers and phones.
    "Eligibility": { "PermitLimit": 30, "Window": "00:10:00" },
    // GET /doctors/{id}/slots: the only public read that plans a calendar per call.
    "Slots": { "PermitLimit": 120, "Window": "00:01:00" },
    // GET /prescriptions/{id}/verify: public, scanned from QR codes.
    "PrescriptionVerify": { "PermitLimit": 30, "Window": "00:01:00" }
  },
  "ForwardedHeaders": {
    "TrustCloudflare": false
  },
